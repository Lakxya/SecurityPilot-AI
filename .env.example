# SecurityPilotAI Production Environment Configuration Example
# Copy this file to .env and replace all default secrets before deploying to production.

# Application Environment (development | staging | production)
ENVIRONMENT=production

# Core Security & Cryptography (REQUIRED in production - min 32 chars)
SECRET_KEY=generate-a-cryptographically-secure-random-key-here-min-32-chars

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Persistence URL
DATABASE_URL=sqlite+aiosqlite:///./securitypilot.db

# Server Bind Settings
PORT=8000
HOST=0.0.0.0
